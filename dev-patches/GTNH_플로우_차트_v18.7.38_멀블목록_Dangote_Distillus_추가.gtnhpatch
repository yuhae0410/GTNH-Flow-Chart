{
  "kind": "gtnh-flow-patch",
  "id": "add-dangote-distillus-multiblock-18.7.38",
  "minBase": "18.7.8",
  "version": "18.7.38",
  "title": "멀블 목록에 Dangote Distillus 추가",
  "description": "사용자 정의 기계의 NEI · GT 멀티 블럭/컨트롤러 목록에 Dangote Distillus를 추가합니다. 기존 v18.7.37 DT 계열 OUTPUT 번호 기능에서 Dangote Distillus도 그대로 DT 계열로 인식됩니다.",
  "css": "",
  "js": "\n(function addDangoteDistillus1838(){\n  if(window.__GTNH_ADD_DANGOTE_1838)return;\n  window.__GTNH_ADD_DANGOTE_1838=true;\n\n  const NAME='Dangote Distillus';\n  const key=NAME.toLowerCase();\n\n  function findDangoteImage(){\n    /* v18.7.x NEI exact lookup을 최우선 사용 */\n    try{\n      const hit=typeof NEI_EXACT_1875!=='undefined' && NEI_EXACT_1875[key];\n      if(hit?.image)return hit.image;\n    }catch(_){}\n\n    /* 다른 NEI/GT 라이브러리에 이미 들어 있으면 재사용 */\n    const pools=[];\n    try{ if(typeof gtSingleIcons!=='undefined')pools.push(gtSingleIcons); }catch(_){}\n    try{ if(typeof gtMultiIcons!=='undefined')pools.push(gtMultiIcons); }catch(_){}\n    try{ if(typeof gtSolidIcons!=='undefined')pools.push(gtSolidIcons); }catch(_){}\n    for(const arr of pools){\n      const hit=(arr||[]).find(x=>String(x?.name||'').trim().toLowerCase()===key);\n      if(hit?.image)return hit.image;\n    }\n    return null;\n  }\n\n  let added=false;\n\n  try{\n    if(typeof gtMultiIcons!=='undefined' && Array.isArray(gtMultiIcons)){\n      const exists=gtMultiIcons.some(\n        x=>String(x?.name||'').trim().toLowerCase()===key\n      );\n      if(!exists){\n        gtMultiIcons.push({\n          name:NAME,\n          image:findDangoteImage()\n        });\n        added=true;\n      }\n    }\n  }catch(e){\n    console.error('Dangote Distillus multiblock add failed:',e);\n  }\n\n  /* 현재 멀블 선택창이 열려 있어도 즉시 검색 가능하게 갱신 */\n  try{\n    const cat=document.getElementById('iconCategory')?.value;\n    if(cat==='gt_multi'){\n      if(typeof renderCustomIconGrid==='function')renderCustomIconGrid();\n      else if(typeof renderIconPickerRows==='function')renderIconPickerRows();\n    }\n  }catch(_){}\n\n  if(typeof showCadToast==='function'){\n    showCadToast(\n      added\n        ? 'v18.7.38 · 멀블 목록에 Dangote Distillus 추가'\n        : 'v18.7.38 · Dangote Distillus 멀블 확인 완료'\n    );\n  }\n})();\n"
}