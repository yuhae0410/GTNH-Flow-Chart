{
  "kind": "gtnh-flow-patch",
  "id": "port-copy-reorder-18.7.36",
  "minBase": "18.7.8",
  "version": "18.7.36",
  "title": "포트 드래그 복사 + INPUT/OUTPUT 순서 변경",
  "description": "이미 배치된 유체/고체 포트를 다른 기계로 드래그해 복사할 수 있습니다. 같은 기계 안에서는 드래그로 순서를 변경하거나 INPUT/OUTPUT 사이를 이동할 수 있습니다. 각 포트에 ▲/▼ 순서 버튼과 ⇄ INPUT/OUTPUT 이동 버튼도 추가합니다. 포트의 이미지, NC, 수량, 배수, catalog 정보는 그대로 보존하며 새 복사본만 새 port id를 받습니다.",
  "css": "\n/* ===== v18.7.36 port copy / reorder ===== */\n.port{\n  position:relative!important;\n}\n\n/* input/button 위가 아닌 포트 본체를 잡아 드래그 */\n.port.port-drag-enabled{\n  cursor:grab;\n}\n.port.port-dragging{\n  opacity:.48!important;\n  cursor:grabbing!important;\n}\n\n/* 드래그 삽입 위치 */\n.port.port-drop-before::before,\n.port.port-drop-after::after{\n  content:\"\"!important;\n  position:absolute!important;\n  left:7px!important;\n  right:7px!important;\n  height:2px!important;\n  background:var(--accent)!important;\n  border-radius:2px!important;\n  z-index:50!important;\n  pointer-events:none!important;\n  box-shadow:0 0 5px color-mix(in srgb,var(--accent) 60%,transparent)!important;\n}\n.port.port-drop-before::before{top:-1px!important}\n.port.port-drop-after::after{bottom:-1px!important}\n\n.node.port-copy-target{\n  box-shadow:\n    var(--shadow),\n    0 0 0 2px color-mix(in srgb,var(--accent) 62%,transparent)!important;\n}\n\n/* 오른쪽 조작 버튼 */\n.port-order-tools{\n  display:inline-flex!important;\n  align-items:center!important;\n  gap:1px!important;\n  flex:0 0 auto!important;\n  margin-left:1px!important;\n}\n.port-order-tools button{\n  width:15px!important;\n  min-width:15px!important;\n  height:18px!important;\n  min-height:18px!important;\n  padding:0!important;\n  margin:0!important;\n  display:grid!important;\n  place-items:center!important;\n  border:0!important;\n  border-radius:3px!important;\n  background:transparent!important;\n  color:var(--muted)!important;\n  font-size:8px!important;\n  line-height:1!important;\n}\n.port-order-tools button:hover{\n  background:var(--panel3)!important;\n  color:var(--text)!important;\n}\n.port-order-tools .port-side-move{\n  font-size:10px!important;\n}\n\n/* 드래그 가능한 영역임을 은은하게 표시 */\n.port .port-img,\n.port .dot,\n.port .port-name{\n  cursor:grab!important;\n}\n",
  "js": "\n(function portCopyReorder1836(){\n  if(window.__GTNH_PORT_COPY_REORDER_1836)return;\n  window.__GTNH_PORT_COPY_REORDER_1836=true;\n\n  const MIME='application/x-gtnh-flow-port';\n  const cv=document.getElementById('canvas')||document.body;\n  const ws=document.querySelector('.workspace')||document.getElementById('workspace')||cv.parentElement;\n\n  let dragInfo=null;\n\n  function uid(){\n    return 'p'+Math.random().toString(36).slice(2)+Date.now().toString(36).slice(-4);\n  }\n\n  function nodeById(id){\n    return (nodes||[]).find(n=>n.id===id);\n  }\n\n  function locatePort(node,pid){\n    if(!node)return null;\n    let i=(node.inputs||[]).findIndex(p=>p.id===pid);\n    if(i>=0)return {side:'inputs',index:i,port:node.inputs[i]};\n    i=(node.outputs||[]).findIndex(p=>p.id===pid);\n    if(i>=0)return {side:'outputs',index:i,port:node.outputs[i]};\n    return null;\n  }\n\n  function clonePort(port){\n    let copy;\n    try{copy=structuredClone(port)}\n    catch(_){copy=JSON.parse(JSON.stringify(port))}\n    copy.id=uid();\n    return copy;\n  }\n\n  function refresh(){\n    /* 포트 변경에는 그룹/주석 전체 렌더가 필요 없음 */\n    if(typeof renderNodes==='function')renderNodes();\n    if(typeof drawArrows==='function')drawArrows();\n    if(typeof updateMap==='function')requestAnimationFrame(updateMap);\n    if(typeof autosave==='function')autosave();\n  }\n\n  function clearMarks(){\n    document.querySelectorAll('.port-drop-before,.port-drop-after')\n      .forEach(x=>x.classList.remove('port-drop-before','port-drop-after'));\n    document.querySelectorAll('.node.port-copy-target')\n      .forEach(x=>x.classList.remove('port-copy-target'));\n  }\n\n  function nodeAndSideFromPoint(nodeEl,clientX){\n    const r=nodeEl.getBoundingClientRect();\n    return clientX < r.left+r.width/2 ? 'inputs' : 'outputs';\n  }\n\n  function insertionFor(nodeEl,side,clientY){\n    const cls=side==='inputs'?'.port.in':'.port.out';\n    const list=[...nodeEl.querySelectorAll(cls)];\n    for(let i=0;i<list.length;i++){\n      const r=list[i].getBoundingClientRect();\n      if(clientY < r.top+r.height/2){\n        return {index:i,el:list[i],after:false};\n      }\n    }\n    return {index:list.length,el:list[list.length-1]||null,after:true};\n  }\n\n  function markInsertion(nodeEl,side,clientY){\n    clearMarks();\n    nodeEl.classList.add('port-copy-target');\n    const ins=insertionFor(nodeEl,side,clientY);\n    if(ins.el){\n      ins.el.classList.add(ins.after?'port-drop-after':'port-drop-before');\n    }\n    return ins;\n  }\n\n  function moveOne(nid,pid,delta){\n    const n=nodeById(nid),loc=locatePort(n,pid);\n    if(!n||!loc)return;\n    const arr=n[loc.side];\n    const ni=loc.index+delta;\n    if(ni<0||ni>=arr.length)return;\n    [arr[loc.index],arr[ni]]=[arr[ni],arr[loc.index]];\n    refresh();\n  }\n\n  function switchSide(nid,pid){\n    const n=nodeById(nid),loc=locatePort(n,pid);\n    if(!n||!loc)return;\n    const from=n[loc.side];\n    const [p]=from.splice(loc.index,1);\n    const to=loc.side==='inputs'?'outputs':'inputs';\n    n[to].push(p);\n    refresh();\n  }\n\n  function addTools(portEl,nid,pid){\n    if(portEl.querySelector('.port-order-tools'))return;\n    const tools=document.createElement('span');\n    tools.className='port-order-tools';\n    tools.innerHTML=\n      '<button type=\"button\" class=\"port-up\" title=\"위로\">▲</button>'+\n      '<button type=\"button\" class=\"port-down\" title=\"아래로\">▼</button>'+\n      '<button type=\"button\" class=\"port-side-move\" title=\"INPUT / OUTPUT 이동\">⇄</button>';\n\n    /* 삭제 X 바로 앞 */\n    const del=portEl.querySelector('.port-x');\n    if(del)del.before(tools);\n    else portEl.appendChild(tools);\n\n    tools.addEventListener('mousedown',e=>e.stopPropagation());\n    tools.addEventListener('click',e=>{\n      e.preventDefault();e.stopPropagation();\n      if(e.target.closest('.port-up'))moveOne(nid,pid,-1);\n      else if(e.target.closest('.port-down'))moveOne(nid,pid,1);\n      else if(e.target.closest('.port-side-move'))switchSide(nid,pid);\n    });\n  }\n\n  function enhancePort(portEl,nodeEl){\n    const nid=nodeEl.dataset.id;\n    const amount=portEl.querySelector('.amount');\n    const factor=portEl.querySelector('.factor');\n    const pid=amount?.dataset.pid||factor?.dataset.pid||portEl.querySelector('.port-x')?.dataset.pid;\n    if(!nid||!pid)return;\n\n    portEl.dataset.portId=pid;\n    portEl.dataset.nodeId=nid;\n    portEl.classList.add('port-drag-enabled');\n    portEl.draggable=true;\n\n    addTools(portEl,nid,pid);\n\n    if(portEl.dataset.dragBound1836==='1')return;\n    portEl.dataset.dragBound1836='1';\n\n    portEl.addEventListener('dragstart',e=>{\n      /* 숫자 입력 / 버튼을 잡았을 때는 드래그 금지 */\n      if(e.target.closest('input,button,.port-order-tools')){\n        e.preventDefault();\n        return;\n      }\n\n      const n=nodeById(nid),loc=locatePort(n,pid);\n      if(!n||!loc){e.preventDefault();return}\n\n      dragInfo={nodeId:nid,portId:pid,side:loc.side};\n      portEl.classList.add('port-dragging');\n\n      try{\n        e.dataTransfer.setData(MIME,JSON.stringify(dragInfo));\n        /* Firefox 호환용이지만 기존 catalog drop으로 오인되지 않게 별도 키만 사용 */\n      }catch(_){}\n      e.dataTransfer.effectAllowed='copyMove';\n\n      /* 드래그 고스트는 현재 포트를 그대로 사용 */\n      try{e.dataTransfer.setDragImage(portEl,18,18)}catch(_){}\n    });\n\n    portEl.addEventListener('dragend',()=>{\n      dragInfo=null;\n      portEl.classList.remove('port-dragging');\n      clearMarks();\n    });\n  }\n\n  function enhanceAll(root=cv){\n    root.querySelectorAll('.node').forEach(nodeEl=>{\n      nodeEl.querySelectorAll('.port').forEach(p=>enhancePort(p,nodeEl));\n    });\n  }\n\n  function isPortDrag(e){\n    if(dragInfo)return true;\n    return Array.from(e.dataTransfer?.types||[]).includes(MIME);\n  }\n\n  function infoFromEvent(e){\n    if(dragInfo)return dragInfo;\n    try{\n      const s=e.dataTransfer.getData(MIME);\n      return s?JSON.parse(s):null;\n    }catch(_){return null}\n  }\n\n  /*\n   * capture에서 기존 workspace catalog drop보다 먼저 처리.\n   * 다른 노드 => COPY\n   * 같은 노드 => MOVE / reorder\n   */\n  ws.addEventListener('dragover',e=>{\n    if(!isPortDrag(e))return;\n    const target=e.target.closest('.node');\n    if(!target)return;\n\n    e.preventDefault();\n    e.stopPropagation();\n    e.stopImmediatePropagation();\n\n    const side=nodeAndSideFromPoint(target,e.clientX);\n    markInsertion(target,side,e.clientY);\n\n    const info=dragInfo;\n    e.dataTransfer.dropEffect=info&&info.nodeId===target.dataset.id?'move':'copy';\n  },true);\n\n  ws.addEventListener('drop',e=>{\n    if(!isPortDrag(e))return;\n    const targetEl=e.target.closest('.node');\n    if(!targetEl)return;\n\n    e.preventDefault();\n    e.stopPropagation();\n    e.stopImmediatePropagation();\n\n    const info=infoFromEvent(e);\n    if(!info){clearMarks();return}\n\n    const srcNode=nodeById(info.nodeId);\n    const srcLoc=locatePort(srcNode,info.portId);\n    const dstNode=nodeById(targetEl.dataset.id);\n    if(!srcNode||!srcLoc||!dstNode){clearMarks();return}\n\n    const dstSide=nodeAndSideFromPoint(targetEl,e.clientX);\n    let ins=insertionFor(targetEl,dstSide,e.clientY);\n    let insertIndex=ins.index;\n\n    if(srcNode.id===dstNode.id){\n      /* 같은 노드: 실제 객체를 이동 */\n      const srcArr=srcNode[srcLoc.side];\n      const [port]=srcArr.splice(srcLoc.index,1);\n\n      /* 같은 배열에서 앞 항목을 제거했으면 목적 인덱스 보정 */\n      if(srcLoc.side===dstSide && srcLoc.index<insertIndex)insertIndex--;\n      insertIndex=Math.max(0,Math.min(insertIndex,dstNode[dstSide].length));\n      dstNode[dstSide].splice(insertIndex,0,port);\n\n      if(typeof showCadToast==='function')showCadToast('포트 순서를 변경했습니다.');\n    }else{\n      /* 다른 노드: 복사. source는 그대로 */\n      const copy=clonePort(srcLoc.port);\n      insertIndex=Math.max(0,Math.min(insertIndex,dstNode[dstSide].length));\n      dstNode[dstSide].splice(insertIndex,0,copy);\n\n      if(typeof showCadToast==='function')showCadToast('포트를 다른 기계에 복사했습니다.');\n    }\n\n    dragInfo=null;\n    clearMarks();\n    refresh();\n  },true);\n\n  /* 노드 바깥에는 포트 drop 금지 - 원본 삭제 방지 */\n  ws.addEventListener('dragover',e=>{\n    if(!isPortDrag(e))return;\n    if(!e.target.closest('.node'))clearMarks();\n  },true);\n\n  enhanceAll();\n\n  /* renderNodes가 DOM을 다시 만들 때 새 포트만 바인딩 */\n  let raf=0;\n  const mo=new MutationObserver(records=>{\n    let needed=false;\n    for(const r of records){\n      for(const n of r.addedNodes){\n        if(n.nodeType===1&&(n.classList?.contains('node')||n.querySelector?.('.node,.port'))){\n          needed=true;break;\n        }\n      }\n      if(needed)break;\n    }\n    if(!needed||raf)return;\n    raf=requestAnimationFrame(()=>{\n      raf=0;\n      enhanceAll();\n    });\n  });\n  mo.observe(cv,{childList:true,subtree:true});\n\n  if(typeof showCadToast==='function')\n    showCadToast('v18.7.36 · 포트 복사 / 순서 변경 기능 적용');\n})();\n"
}