{
  "kind": "gtnh-flow-patch",
  "id": "dt-family-output-index-18.7.37",
  "minBase": "18.7.8",
  "version": "18.7.37",
  "title": "DT 계열 OUTPUT 0번부터 번호 표시",
  "description": "Distillation Tower, Dangote Distillus, Mega Distillation Tower 계열의 OUTPUT 포트에 현재 순서 기준 0, 1, 2... 번호를 자동 표시합니다. 포트 순서 변경/INPUT↔OUTPUT 이동/복사 후 재렌더에도 번호가 자동 갱신되며 데이터 구조는 변경하지 않습니다.",
  "css": "\n/* ===== v18.7.37 DT-family output index ===== */\n.port.out .dt-output-index{\n  width:18px!important;\n  min-width:18px!important;\n  height:18px!important;\n  flex:0 0 18px!important;\n  display:inline-grid!important;\n  place-items:center!important;\n  margin-right:1px!important;\n  border:1px solid color-mix(in srgb,var(--output) 68%,var(--border))!important;\n  border-radius:5px!important;\n  background:color-mix(in srgb,var(--output) 12%,var(--panel3))!important;\n  color:var(--output)!important;\n  font-size:9px!important;\n  font-weight:800!important;\n  line-height:1!important;\n  font-variant-numeric:tabular-nums!important;\n  user-select:none!important;\n  pointer-events:none!important;\n}\n\n/* DT 계열만 약간의 여유를 확보. 기존 포트 폭/입력칸은 건드리지 않음. */\n.node.dt-output-numbered .port.out{\n  gap:4px!important;\n}\n",
  "js": "\n(function dtOutputNumbering1837(){\n  if(window.__GTNH_DT_OUTPUT_NUMBERING_1837)return;\n  window.__GTNH_DT_OUTPUT_NUMBERING_1837=true;\n\n  const cv=document.getElementById('canvas')||document.body;\n\n  function norm(v){\n    return String(v||'')\n      .toLowerCase()\n      .replace(/[_-]+/g,' ')\n      .replace(/\\s+/g,' ')\n      .trim();\n  }\n\n  function nodeById(id){\n    return (nodes||[]).find(n=>n.id===id);\n  }\n\n  function machineTexts(n){\n    const c=(catalog||[]).find(x=>x.id===n?.catalog);\n    return [n?.title,n?.sub,c?.name,c?.sub]\n      .map(norm)\n      .filter(Boolean);\n  }\n\n  function isDTFamily(n){\n    if(!n)return false;\n    const texts=machineTexts(n);\n\n    return texts.some(t=>\n      t==='distillation tower' ||\n      t==='mega distillation tower' ||\n      t==='mega distillation tower 2' ||\n      t==='dangote distillus' ||\n      t==='증류탑' ||\n      t==='메가 증류탑' ||\n      t==='댕고트 디스틸러스' ||\n      t==='당고테 디스틸러스'\n    );\n  }\n\n  function numberOneNode(nodeEl){\n    if(!nodeEl?.classList?.contains('node'))return;\n    const n=nodeById(nodeEl.dataset.id);\n    const enabled=isDTFamily(n);\n\n    nodeEl.classList.toggle('dt-output-numbered',enabled);\n\n    /* 기계 종류가 바뀌었을 때 남은 표시는 제거 */\n    if(!enabled){\n      nodeEl.querySelectorAll('.dt-output-index').forEach(el=>el.remove());\n      return;\n    }\n\n    const outs=[...nodeEl.querySelectorAll('.port.out')];\n    outs.forEach((portEl,index)=>{\n      let badge=portEl.querySelector(':scope > .dt-output-index');\n      if(!badge){\n        badge=document.createElement('span');\n        badge.className='dt-output-index';\n        badge.setAttribute('aria-hidden','true');\n\n        /* 번호 → 포트 점 → 이름 순서 */\n        const dot=portEl.querySelector(':scope > .dot');\n        if(dot)portEl.insertBefore(badge,dot);\n        else portEl.prepend(badge);\n      }\n      const value=String(index);\n      if(badge.textContent!==value)badge.textContent=value;\n      badge.title='DT OUTPUT '+value;\n    });\n\n    /* OUTPUT 삭제/이동 후 남을 수 있는 초과 배지 방어 */\n    nodeEl.querySelectorAll('.port:not(.out) > .dt-output-index').forEach(el=>el.remove());\n  }\n\n  function numberAll(root=cv){\n    if(root?.classList?.contains('node'))numberOneNode(root);\n    root?.querySelectorAll?.('.node').forEach(numberOneNode);\n  }\n\n  numberAll();\n\n  /* renderNodes / v18.7.36 포트 재렌더 뒤에 추가된 노드만 RAF 1회로 처리 */\n  let raf=0;\n  const pending=new Set();\n  const mo=new MutationObserver(records=>{\n    for(const r of records){\n      for(const added of r.addedNodes){\n        if(added.nodeType!==1)continue;\n        if(added.classList?.contains('node'))pending.add(added);\n        added.querySelectorAll?.('.node').forEach(n=>pending.add(n));\n      }\n    }\n    if(!pending.size||raf)return;\n    raf=requestAnimationFrame(()=>{\n      raf=0;\n      const batch=[...pending];\n      pending.clear();\n      batch.forEach(numberOneNode);\n    });\n  });\n  mo.observe(cv,{childList:true,subtree:true});\n\n  /* 제목/부제목을 직접 수정해 DT가 되거나 DT에서 벗어나는 경우도 즉시 반영 */\n  document.addEventListener('focusout',e=>{\n    const nodeEl=e.target?.closest?.('.node');\n    if(nodeEl)queueMicrotask(()=>numberOneNode(nodeEl));\n  },true);\n\n  if(typeof showCadToast==='function')\n    showCadToast('v18.7.37 · DT 계열 OUTPUT 번호 0부터 표시');\n})();\n"
}