{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTNH Flow Chart",
  "version": "18.7.38",
  "identifier": "com.gtnh.flowchart",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GTNH Flow Chart",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MzE1N0M2RkI0RDlFQUYKUldTdm5rMzd4bGN4eDFjVzFYN2NhUlZabXhQUGd0YXdDSjZMbU5rVTNGeFRpVHdmdjg0N0hYVlgK",
      "endpoints": [
        "https://github.com/yuhae0410/GTNH-Flow-Chart/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
